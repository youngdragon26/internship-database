-- Sử dụng cơ sở dữ liệu classicmodels (hoặc cơ sở dữ liệu mẫu của bạn)
USE classicmodels;

-- ==========================================
-- 1. THAM SỐ LOẠI IN
-- ==========================================
DELIMITER //

CREATE PROCEDURE IF NOT EXISTS getCusById(IN cusNum INT(11))
BEGIN
  SELECT * FROM customers WHERE customerNumber = cusNum;
END //

DELIMITER ;

-- ==========================================
-- 2. THAM SỐ LOẠI OUT
-- ==========================================
DELIMITER //

CREATE PROCEDURE IF NOT EXISTS GetCustomersCountByCity(
    IN in_city VARCHAR(50),
    OUT total INT
)
BEGIN
    SELECT COUNT(customerNumber)
    INTO total
    FROM customers
    WHERE city = in_city;
END//

DELIMITER ;

-- ==========================================
-- 3. THAM SỐ LOẠI INOUT
-- ==========================================
DELIMITER //

CREATE PROCEDURE IF NOT EXISTS SetCounter(
    INOUT counter INT,
    IN inc INT
)
BEGIN
    SET counter = counter + inc;
END//

DELIMITER ;
